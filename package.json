{
  "name": "btviewer",
  "version": "1.0.0",
  "description": "BT在线播放桌面应用 - 支持磁力链接和torrent文件在线播放",
  "main": "release/app/main/main.js",
  "author": "dsjerry",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "package:dir": "npm run build && electron-builder --win --dir",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.1",
    "video.js": "^8.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/video.js": "^7.3.58",
    "@vitejs/plugin-react": "^4.2.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsjerry/btviewer.git"
  },
  "homepage": "https://github.com/dsjerry/btviewer#readme",
  "bugs": {
    "url": "https://github.com/dsjerry/btviewer/issues"
  }
}
